# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://rental:rental_dev_password@localhost:5432/equipment_rental

# Used for signing auth cookies (Module 1). Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Policy config file (relative to the server folder)
POLICY_CONFIG_PATH=./config/equipment_policy_config.json
POLICY_CONFIG_VERSIONS_DIR=./config/versions
POLICY_CONFIG_POLL_MS=2000

LOG_LEVEL=info
